APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8000

# Custom Fields
#------------------
PANEL_URL=""
PANEL_API=""
PANEL_NEST_ID=""
PANEL_EGG_ID=""
RUST_MAX_PORTS=""
STRIPE_TOKEN=""
PACKAGE_PRICE="20"
REFUND_PERCENTAGE="85"
REFUND_DAYS="2"
LEMON_PRODUCT_ID=""
LEMON_PRODUCT_VERIENT_ID=""
LEMON_STORE=""
LEMON_SQUEEZY_API_KEY=""
ACTIVE_GATEWAY="lemon_squeezy or stripe"
STRIPE_PRODUCT_ID=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
DISCORD_LINK=""
YOUTUBE_LINK=""
FACEBOOK_LINK=""
TWITTER_LINK=""
TRUSTPILOT_LINK=""
DISCORD_ORDER_WEBHOOK=""
DISCORD_SERVER_WEBHOOK=""
DISCORD_EXCEPTION_WEBHOOK=""
DISCORD_REFUND_WEBHOOK=""
TRUSTPILOT_EMAIL=""
